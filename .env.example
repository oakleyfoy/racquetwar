# ---------------------------------------------------------------------------
# Certified Tournament Director application form
# Copy to .env.local for local development, or set these in the Render dashboard.
# ---------------------------------------------------------------------------

# Postgres connection string. Render provides this automatically when the
# database is linked in render.yaml. Leave unset locally to fall back to
# console logging of submissions.
DATABASE_URL=postgresql://user:password@host:5432/racquetwar

# Force TLS on or off. Leave unset to auto-detect (on for remote, off for localhost).
# DATABASE_SSL=true

# --- Email notifications -----------------------------------------------------
# Mailbox that sends the notification and the applicant auto-reply. With Microsoft
# Graph this must be a real mailbox in the tenant below, since Graph sends as it.
MAIL_FROM_EMAIL=info@racquetwar.com
# Inbox that receives new applications.
CTD_TO_EMAIL=oakley@wargroupllc.com

# Preferred transport: Microsoft Graph (same app registration pattern used by
# the Elite and Premier sites). Requires the Mail.Send application permission.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret

# Optional SMTP fallback, used only when the Microsoft values are absent.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# --- Spam protection ---------------------------------------------------------
# reCAPTCHA v3. Required in production; skipped locally when unset.
RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
RECAPTCHA_MIN_SCORE=0.5

# Optional Microsoft Bookings page for CTD screening invitations.
# Server-side only. Do not prefix with NEXT_PUBLIC_. Leave unset to disable
# the Send Screening Invitation action.
# CTD_SCREENING_BOOKING_URL=

# --- Admin area --------------------------------------------------------------
# Password for /tournament-director/admin. Required to open the admin area.
ADMIN_PASSWORD=choose-a-long-random-password
# Secret used to sign the admin session cookie and to salt stored IP hashes.
# Defaults to ADMIN_PASSWORD if unset, but a separate value is better.
ADMIN_SESSION_SECRET=another-long-random-string

# --- Site ---------------------------------------------------------------------
# Public origin this app is served from. Used for canonical and share URLs.
NEXT_PUBLIC_SITE_URL=https://apply.wartournaments.com
# Where the logo and "back" button lead. Kept separate from the origin above
# because racquetwar.com now only serves a notice saying Racquet War events
# are run by War Tournaments.
NEXT_PUBLIC_MAIN_SITE_URL=https://wartournaments.com/racquet-war/

# Set to true ONLY when this app serves the full racquetwar.com domain.
# While WordPress is still live, leave this unset so the Render hostname
# stays out of search results.
# ALLOW_SEARCH_INDEXING=true
